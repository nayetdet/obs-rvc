{
  "name": "obs-rvc-build",
  "image": "mcr.microsoft.com/devcontainers/cpp:1-ubuntu-24.04",
  "workspaceMount": "source=${localWorkspaceFolder}/../..,target=/workspaces/obs-rvc,type=bind",
  "workspaceFolder": "/workspaces/obs-rvc",
  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {
      "configureZshAsDefaultShell": true,
      "installOhMyZsh": true,
      "username": "vscode"
    },
    "ghcr.io/devcontainers/features/python:1": {
      "version": "3.14"
    },
    "ghcr.io/devcontainers-extra/features/uv:1": {},
    "ghcr.io/devcontainers/features/node:1": {},
    "ghcr.io/devcontainer-community/devcontainer-features/bun.sh:1": {},
    "ghcr.io/rocker-org/devcontainer-features/apt-packages:1": {
      "packages": "ccache,libgles2-mesa-dev,libobs-dev,libqt6svg6-dev,libsimde-dev,ninja-build,obs-studio,pkg-config,qt6-base-dev,qt6-base-private-dev,software-properties-common"
    }
  }
}
