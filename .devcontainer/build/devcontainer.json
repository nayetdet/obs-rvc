{
  "name": "obs-rvc-build",
  "image": "mcr.microsoft.com/devcontainers/cpp:1-ubuntu-24.04",
  "workspaceMount": "source=${localWorkspaceFolder}/../..,target=/workspaces/obs-rvc,type=bind",
  "workspaceFolder": "/workspaces/obs-rvc",
  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {
      "configureZshAsDefaultShell": true,
      "installOhMyZsh": true,
      "username": "vscode"
    },
    "ghcr.io/devcontainers-extra/features/zsh-plugins:0": {
      "plugins": "zsh-autosuggestions zsh-syntax-highlighting",
      "omzPlugins": "https://github.com/zsh-users/zsh-autosuggestions https://github.com/zsh-users/zsh-syntax-highlighting",
      "username": "vscode"
    },
    "ghcr.io/postfinance/devcontainer-features/python:1.1.0": {
      "version": "3.12"
    },
    "ghcr.io/devcontainers-extra/features/uv:1": {},
    "ghcr.io/devcontainers/features/node:1": {},
    "ghcr.io/devcontainer-community/devcontainer-features/bun.sh:1": {},
    "ghcr.io/rocker-org/devcontainer-features/apt-packages:1": {
      "packages": "ccache,ffmpeg,libavcodec-dev,libavdevice-dev,libavfilter-dev,libavformat-dev,libavutil-dev,libgles2-mesa-dev,libobs-dev,libsndfile1,libportaudio2,libqt6svg6-dev,libsimde-dev,libswresample-dev,libswscale-dev,ninja-build,obs-studio,pkg-config,qt6-base-dev,qt6-base-private-dev,software-properties-common,unzip"
    }
  }
}
